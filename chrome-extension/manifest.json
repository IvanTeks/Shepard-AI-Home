{
  "manifest_version": 3,
  "name": "Shepard Chrome Bridge",
  "version": "0.2.0",
  "description": "Explicitly share the current Chrome page with your local Shepard Labyrinth.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_title": "Shepard Chrome Bridge",
    "default_popup": "popup.html"
  }
}
